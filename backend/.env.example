# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# MongoDB (Mongoose). The server does not start without it.
MONGO_URI="mongodb://127.0.0.1:27017/ichiba"

# MongoDB Atlas (production). Same shape as MONGO_URI pointing at the cluster.
# Set MONGO_URI to this value when you deploy; see scripts/migrar-a-atlas.ts.
# MONGO_URI_ATLAS="mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/Ichiba?appName=Ichiba"

# Signature of the session tokens (JWT).
JWT_SECRET="cambia-esta-frase-por-una-clave-larga"

# Optional: server port (defaults to 5000).
# PORT=5000

# PayPal (required to charge). Create an app at https://developer.paypal.com
# and copy the Client ID and Secret here.
# Use https://api-m.sandbox.paypal.com for test payments or
# https://api-m.paypal.com for live payments.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# MercadoPago (Checkout Pro), used when the seller picked "Mercado Pago" at
# sign-up. Get the Access Token at https://www.mercadopago.com/developers/
# (Tu cuenta > Credenciales). Keep the TEST credentials while in development
# and switch to the production ones when you go live.
MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_API_BASE="https://api.mercadopago.com"

# Public URL of this backend. Enables the MercadoPago webhook and lets product
# images show up inside the payment page. Local example: http://localhost:5000
# Production example: BACKEND_URL="https://backend-production-xxxx.up.railway.app"
# BACKEND_URL=""

# Frontend origin(s), comma separated. Used to lock down CORS and as the
# return/cancel URL of PayPal and MercadoPago.
# Production example: FRONTEND_URL="https://mi-sitio.vercel.app"
FRONTEND_URL="http://localhost:5173"

# Set this on your hosting so CORS only accepts FRONTEND_URL
# (in development it also accepts localhost and the local network).
# NODE_ENV=production

# Optional: Gmail credentials to send mail. If missing, verification codes
# are printed in the backend console with the "[correo local]" prefix.
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""

# StructOCR key, required to validate the INE during registration.
# STRUCTOCR_API_KEY=""
