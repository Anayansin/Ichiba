# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# MongoDB (Mongoose). The server does not start without it.
MONGO_URI="mongodb://127.0.0.1:27017/ichiba"

# MongoDB Atlas (production). Same shape as MONGO_URI pointing at the cluster.
# Set MONGO_URI to this value when you deploy; see scripts/migrar-a-atlas.ts.
# MONGO_URI_ATLAS="mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/Ichiba?appName=Ichiba"

# Signature of the session tokens (JWT).
JWT_SECRET="cambia-esta-frase-por-una-clave-larga"

# Optional: server port (defaults to 5000).
# PORT=5000

# PayPal (required to charge). Create an app at https://developer.paypal.com
# and copy the Client ID and Secret here.
# Use https://api-m.sandbox.paypal.com for test payments or
# https://api-m.paypal.com for live payments.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# RNF-PAG-20: opcional. Si se define, PayPal usa este Merchant ID (13
# caracteres) como cuenta que recibe la comisión. Si se deja vacío, la
# comisión se acredita a la cuenta dueña de la app (la plataforma). En ambos
# casos la cuenta debe estar habilitada para PayPal Complete Payments Platform
# (Marketplaces and Platforms) y los vendedores deben estar enrolados.
PAYPAL_PLATFORM_MERCHANT_ID=""
# "platform_fee" (predeterminado) cobra la comisión real en PayPal.
# "registro" solo la calcula y muestra: úsalo únicamente en desarrollo o
# mientras PayPal aprueba la cuenta de plataforma. Nunca en producción.
PAYPAL_COMISION_MODO="platform_fee"

# URL exacta registrada en la app de PayPal para el callback OAuth. Si no se
# define, se usa `${BACKEND_URL}/api/pagos/paypal/vincular/callback`.
# PAYPAL_REDIRECT_URI="https://backend-production-xxxx.up.railway.app/api/pagos/paypal/vincular/callback"

# Llave AES-256-GCM (64 caracteres hexadecimales) para cifrar el token OAuth
# del vendedor. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No la cambies después de vincular vendedores: sus tokens dejarían de leerse.
PAYPAL_LLAVE_CIFRADO=""

# MercadoPago (Checkout Pro), used when the seller picked "Mercado Pago" at
# sign-up. Get the Access Token at https://www.mercadopago.com/developers/
# (Tu cuenta > Credenciales). Keep the TEST credentials while in development
# and switch to the production ones when you go live.
MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_API_BASE="https://api.mercadopago.com"

# Public URL of this backend. Enables the MercadoPago webhook and lets product
# images show up inside the payment page. Local example: http://localhost:5000
# Production example: BACKEND_URL="https://backend-production-xxxx.up.railway.app"
# BACKEND_URL=""

# Frontend origin(s), comma separated. Used to lock down CORS and as the
# return/cancel URL of PayPal and MercadoPago.
# Production example: FRONTEND_URL="https://mi-sitio.vercel.app"
FRONTEND_URL="http://localhost:5173"

# Set this on your hosting so CORS only accepts FRONTEND_URL
# (in development it also accepts localhost and the local network).
# NODE_ENV=production

# Optional: Gmail credentials to send mail. If missing, verification codes
# are printed in the backend console with the "[correo local]" prefix.
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""

# Optional: where the "revisa mi alta denegada" requests are sent. If it is
# not set, they go to GMAIL_USER (the platform mailbox).
# CORREO_ADMINISTRADORES="administradores@midominio.com"

# StructOCR key, required to validate the INE during registration.
# STRUCTOCR_API_KEY=""

# Google Cloud Vision. Required in production to moderate product photos
# (LABEL_DETECTION) and receipts/chat images (SAFE_SEARCH_DETECTION). If it is
# missing or Vision fails, moderation fails closed.
# GOOGLE_VISION_API_KEY=""
# Do NOT set these in production:
# GOOGLE_VISION_ENDPOINT=""
# VISION_MODERACION=""
