{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de Ichiba",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec \"node --harmony-temporal --import tsx\" src/server.ts",
    "start": "node --harmony-temporal --import tsx src/server.ts",
    "seed": "node --harmony-temporal --import tsx scripts/seed.ts",
    "admin": "node --harmony-temporal --import tsx scripts/crear-admin.ts",
    "mcp": "node --harmony-temporal --import tsx src/mcp/arranqueStdio.ts",
    "contract:emit": "prisma contract emit",
    "build": "tsc --noEmit"
  },
  "engines": {
    "node": "24"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "ignore": [
      "node_modules"
    ]
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/orm-postgres": "^8.0.0-rc.13",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.2",
    "prisma": "^8.0.0-rc.17",
    "sharp": "^0.35.3",
    "temporal-polyfill": "^1.0.8",
    "tsx": "^4.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.18.2",
    "nodemon": "^3.1.14",
    "typescript": "^5.7.0"
  }
}
