// use prisma-8

model usuario {
  id                              Int       @id @default(autoincrement())
  nombreCompleto                  String
  direccion                       String
  telefono                        String
  correo                          String    @unique
  rfc                             String
  password                        String
  tipo                            String    @default("vendedor")
  ventasExitosas                  Int       @default(0)
  totalReportes                   Int       @default(0)
  faltasLeves                     Int       @default(0)
  // RQNF10.1 / RQNF10.3: reputación por puntos de infracción (se cancelan a los 8).
  puntosReputacion                Float     @default(0)
  // RQNF10.3 / RQF12: "activa" | "cancelada" (cancelada = solo entregas pendientes).
  estadoCuenta                    String    @default("activa")
  canceladaEn                     DateTime?
  // RQNF10.6: fecha en la que se purgaron los datos personales tras resolverse las entregas.
  datosEliminadosEn               DateTime?
  correoVerificado                Boolean   @default(false)
  codigoCorreo                    String?
  codigoCorreoExpira              DateTime?
  codigoRecuperacion              String?
  codigoRecuperacionExpira        DateTime?
  ineFrente                       String
  ineReverso                      String
  aceptaTerminos                  Boolean
  recibirNotificacionesCriticas   Boolean
  curp                            String?
  ineCodigoReverso                String?
  recibirNotificacionesPublicitarias Boolean @default(false)
  paypalEmail                     String
  horarios                        Json
  horarioConfirmadoEn             DateTime?
  diasSinConfirmarHorario         Int       @default(0)
  createdAt                       DateTime  @default(now())
  updatedAt                       temporal.updatedAtString()
  ventas                          venta[]
  reportes                        reporte[]
}

model venta {
  id            Int      @id @default(autoincrement())
  productoId    String
  vendedorId    Int
  compradorId   String
  monto         Float
  paypalOrderId String
  // RQNF4: ciclo del escrow. Estados:
  //   pendiente_comprobante  -> pago autorizado (PayPal) o aprobado (MercadoPago),
  //                             falta que el comprador registre su comprobante
  //   pendiente_confirmacion -> comprobante enviado; el vendedor debe revisarlo
  //   en_entrega             -> comprobante confirmado; chat abierto para coordinar
  //   completada             -> código de entrega registrado y fondos liberados
  //   reembolsada            -> se devolvió el dinero al comprador
  //   cancelada              -> cancelada sin cobro (autorización anulada)
  estado        String   @default("pendiente_comprobante")
  // RQNF20: palabra clave numérica de 4 dígitos, única por sesión de pago.
  codigoPago    String?
  // RQNF4 (escrow): id de la autorización de PayPal (captura diferida).
  autorizacionPaypalId String?
  // RQF22: comprobante de pago del comprador.
  comprobantePalabraClave String?
  comprobanteReferencia   String?
  comprobanteImagen       String?
  comprobanteEnviadoEn    DateTime?
  // RQNF24 / RQNF31: instante en que el vendedor confirmó el comprobante;
  // desde ahí se abre el chat y corre la inactividad de 3 bloques.
  comprobanteConfirmadoEn DateTime?
  // RQNF24.4: código de confirmación de entrega de 4 dígitos (lo da el
  // comprador al vendedor el día de la entrega).
  codigoEntrega  String?
  // RQNF24: fecha límite para que el vendedor confirme el comprobante
  // (fin de su siguiente bloque de atención).
  confirmacionLimite DateTime?
  // RQNF28 / RQNF31: límite de entrega y último mensaje del chat.
  entregaLimite  DateTime?
  ultimoMensajeEn DateTime?
  entregadoEn    DateTime?
  // RQNF27: id de la captura de PayPal hecha al liberar los fondos;
  // se necesita para poder reembolsar disputas posteriores a la entrega.
  capturaPaypalId String?
  // RQNF10.2 / RQNF23 / RQNF28: reembolsos.
  reembolsadoEn  DateTime?
  reembolsoId    String?
  canceladoMotivo String?
  // RQNF32: retención preventiva de fondos por reportes o disputas.
  retenido       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAtString()
  vendedor      usuario  @relation(fields: [vendedorId], references: [id])
}

model cola {
  id            Int       @id @default(autoincrement())
  productoId    String
  compradorId   String
  correo        String?
  posicion      Int
  estado        String    @default("activa")
  pagoExpiraEn  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAtString()
}

model reporte {
  id                Int      @id @default(autoincrement())
  tipoReportado     String   @default("vendedor")
  sujetoTipo        String
  sujetoId          String
  reportadoPorTipo  String
  reportadoPorId    String
  ventaId           String?
  productoId        String?
  mensajeId         String?
  elemento          String
  categoria         String
  categoriaNombre   String
  tipoFalta         String
  detalle           String?
  estado            String   @default("pendiente")
  vendedorId        Int
  createdAt         DateTime @default(now())
  updatedAt         temporal.updatedAtString()
  vendedor          usuario  @relation(fields: [vendedorId], references: [id])
}
