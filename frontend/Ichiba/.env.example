# Copia este archivo como `.env` (solo desarrollo) o define la variable
# directamente en el panel de tu hosting.
#
# URL raíz del backend, SIN barra final y SIN `/api`:
#   local:      VITE_BACKEND_URL=http://localhost:5000
#   producción: VITE_BACKEND_URL=https://mi-api.up.railway.app
#
# Si no existe, el frontend usa http://localhost:5000 por defecto.
VITE_BACKEND_URL=http://localhost:5000
